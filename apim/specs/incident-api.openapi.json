{
  "openapi": "3.0.4",
  "info": {
    "title": "IncidentAssistant.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Incidents": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "summary": "List incidents",
        "operationId": "ListIncidents",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/IncidentStatus"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Severity"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IncidentDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IncidentDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IncidentDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Incidents"
        ],
        "summary": "Create an incident",
        "operationId": "CreateIncident",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIncidentRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIncidentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIncidentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/Incidents/{id}": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "summary": "Get incident by ID",
        "operationId": "GetIncidentById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Incidents"
        ],
        "summary": "Update an incident",
        "operationId": "UpdateIncident",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateIncidentRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateIncidentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateIncidentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Incidents"
        ],
        "summary": "Delete an incident",
        "operationId": "DeleteIncident",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Incidents/{id}/triage": {
      "post": {
        "tags": [
          "Incidents"
        ],
        "summary": "Triage an incident using past incidents (RAG)",
        "operationId": "TriageIncident",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/Incidents/{id}/triage/baseline": {
      "post": {
        "tags": [
          "Incidents"
        ],
        "summary": "Triage an incident using a baseline approach without retrieval",
        "operationId": "TriageIncidentBaseline",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/Incidents/{id}/similar": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "summary": "Get similar incidents",
        "operationId": "GetSimilarIncidents",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/RetrievalMode"
            }
          },
          {
            "name": "strategy",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ChunkingStrategy"
            }
          },
          {
            "name": "top",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarIncidentsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarIncidentsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarIncidentsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChunkingStrategy": {
        "type": "integer"
      },
      "CitedIncidentDto": {
        "required": [
          "incidentId",
          "title",
          "service",
          "rerankerScore"
        ],
        "type": "object",
        "properties": {
          "incidentId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "rerankerScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "double",
            "nullable": true
          }
        }
      },
      "CreateIncidentRequest": {
        "required": [
          "title",
          "description",
          "severity",
          "category"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "service": {
            "type": "string",
            "nullable": true
          },
          "errorSignatures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "IncidentDto": {
        "required": [
          "id",
          "title",
          "description",
          "severity",
          "status",
          "category",
          "createdAt",
          "resolvedAt",
          "resolutionNotes",
          "service",
          "rootCause",
          "errorSignatures"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/IncidentStatus"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "resolutionNotes": {
            "type": "string",
            "nullable": true
          },
          "service": {
            "type": "string"
          },
          "rootCause": {
            "type": "string",
            "nullable": true
          },
          "errorSignatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "IncidentStatus": {
        "type": "integer"
      },
      "RetrievalMode": {
        "type": "integer"
      },
      "Severity": {
        "type": "integer"
      },
      "SimilarIncidentDto": {
        "required": [
          "incidentId",
          "title",
          "service",
          "matchedSection",
          "score",
          "rerankerScore",
          "crossService",
          "matchedContent"
        ],
        "type": "object",
        "properties": {
          "incidentId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "matchedSection": {
            "type": "string"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "double"
          },
          "rerankerScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "double",
            "nullable": true
          },
          "crossService": {
            "type": "boolean"
          },
          "matchedContent": {
            "type": "string"
          }
        }
      },
      "SimilarIncidentsResponse": {
        "required": [
          "forIncidentId",
          "requestedMode",
          "executedMode",
          "index",
          "fallbackToAllServices",
          "chunkHits",
          "results"
        ],
        "type": "object",
        "properties": {
          "forIncidentId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedMode": {
            "type": "string"
          },
          "executedMode": {
            "type": "string"
          },
          "index": {
            "type": "string"
          },
          "fallbackToAllServices": {
            "type": "boolean"
          },
          "chunkHits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SimilarIncidentDto"
            }
          }
        }
      },
      "TriageDiagnostics": {
        "required": [
          "executedMode",
          "evidence",
          "topRerankerScore",
          "fallbackToAllServices",
          "sourcesProvided",
          "invalidCitations",
          "droppedSteps"
        ],
        "type": "object",
        "properties": {
          "executedMode": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "topRerankerScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "double",
            "nullable": true
          },
          "fallbackToAllServices": {
            "type": "boolean"
          },
          "sourcesProvided": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "invalidCitations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "droppedSteps": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          }
        }
      },
      "TriageResult": {
        "required": [
          "suggestedSeverity",
          "suggestedCategory",
          "troubleshootingSteps"
        ],
        "type": "object",
        "properties": {
          "suggestedSeverity": {
            "type": "string"
          },
          "suggestedCategory": {
            "type": "string"
          },
          "troubleshootingSteps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "likelyRootCause": {
            "type": "string",
            "nullable": true
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TriageStepDto"
            },
            "nullable": true
          },
          "confidence": {
            "type": "string",
            "default": "low"
          },
          "degraded": {
            "type": "string",
            "default": "none"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CitedIncidentDto"
            },
            "nullable": true
          },
          "similarIncidents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SimilarIncidentDto"
            },
            "nullable": true
          },
          "diagnostics": {
            "type": "object",
            "oneOf": [
              {
                "$ref": "#/components/schemas/TriageDiagnostics"
              }
            ],
            "nullable": true
          }
        }
      },
      "TriageStepDto": {
        "required": [
          "text",
          "sourceIncidentIds"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "sourceIncidentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "UpdateIncidentRequest": {
        "required": [
          "title",
          "description",
          "severity",
          "status",
          "category",
          "resolutionNotes"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/IncidentStatus"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "resolutionNotes": {
            "type": "string",
            "nullable": true
          },
          "service": {
            "type": "string",
            "nullable": true
          },
          "rootCause": {
            "type": "string",
            "nullable": true
          },
          "errorSignatures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Incidents"
    }
  ]
}
